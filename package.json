{
  "name": "dsh-purge-plus",
  "version": "1.5.0",
  "description": "DeepSeek Harness 破甲与红队评测插件（dsh-purge-plus）：宿主补丁、提示词注入、工具开关、自检与维护快照。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./presets-plugin": "./lib/presets-plugin.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge-plus": "bin/dsh-purge-plus.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md",
    "DISCLAIMER.md",
    "CHANGELOG.md",
    "test/"
  ],
  "scripts": {
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs && node test/gate.mjs && node test/cwd-variable.mjs",
    "test:gate": "node test/gate.mjs",
    "test:cwd": "node test/cwd-variable.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent",
    "jailbreak",
    "armor",
    "prompt-hardening"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weimin96/dsh-purge-plus.git"
  },
  "homepage": "https://github.com/weimin96/dsh-purge-plus#readme",
  "bugs": {
    "url": "https://github.com/weimin96/dsh-purge-plus/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/weimin96/dsh-purge-plus/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/weimin96/dsh-purge-plus/archive/refs/heads/main.zip",
      "git": "https://github.com/weimin96/dsh-purge-plus.git"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.1 <0.3.0",
      "profiles": [
        "desktop",
        "web"
      ],
      "dshReleases": {
        "0.2.1-rc.1": "compatible",
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "unknown",
        "0.2.2-rc.1": "unknown"
      }
    },
    "version": "1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.1-rc.2",
  "author": {
    "name": "weimin96",
    "url": "https://github.com/weimin96"
  }
}
